-- 1). View All Books,A librarian wants to see all available books.Write a query to display all records from BOOKS.
SELECT * FROM BOOKS;

--2) Find Books by Author,User searches for books written by a specific author. Display books where author = 'JOHN KEATS'.
SELECT * FROM BOOKS 
WHERE AUTHOR='John Keats';

--3) Total Number of Books,Library admin wants total books count.Count number of books in BOOKS table.
SELECT COUNT(BOOK_ID) FROM BOOKS;

--4)List All Members,Admin wants to see all registered members.Display all records from MEMBERS.
SELECT * FROM MEMBERS;

--5)Issued Books Details,Admin wants to see which books are issued.Display all records from ISSUES.
SELECT * FROM ISSUES;

--6. Books Issued Per Member,Admin wants to know how many books each member borrowed.
SELECT MEMBER_ID,COUNT(BOOK_ID) FROM ISSUES
GROUP BY MEMBER_ID;

--7)Book Title with Member Name,Admin wants full issue details. 
SELECT BOOKS.TITLE,MEMBERS.NAME,ISSUES.ISSUE_ID,ISSUES.BOOK_ID,ISSUES.MEMBER_ID,ISSUES.ISSUE_DATE
FROM ISSUES 
JOIN BOOKS ON ISSUES.BOOK_ID=BOOKS.BOOK_ID
JOIN MEMBERS ON ISSUES.MEMBER_ID=MEMBERS.MEMBER_ID;

--8)Most Issued Book,Library wants to find popular books. Find book_id with highest count in ISSUES.
SELECT BOOK_ID, COUNT(*) AS TOTAL_ISSUES FROM ISSUES
GROUP BY BOOK_ID
ORDER BY TOTAL_ISSUES DESC
FETCH FIRST 1 ROW ONLY;

