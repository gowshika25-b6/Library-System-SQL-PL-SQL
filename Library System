--9). Check Book Availability,User enters book_id.If book exists, print "Available", else "Not Available".
DECLARE
    V_BOOK_ID BOOKS.BOOK_ID%TYPE;
BEGIN
    SELECT BOOK_ID INTO V_BOOK_ID FROM BOOKS
    WHERE BOOK_ID=22;
    DBMS_OUTPUT.PUT_LINE('AVAILABLE');
    EXCEPTION
    WHEN NO_DATA_FOUND THEN
    DBMS_OUTPUT.PUT_LINE('NOT AVAILABLE');
END;
/

--10)Issue a Book,Member borrows a book. Insert record into ISSUES using PL/SQL block.

DECLARE
    V_ISSUE_ID NUMBER := 3001;
    V_BOOK_ID NUMBER := 22;
    V_MEMBER_ID NUMBER := 107;
BEGIN
    INSERT INTO ISSUES (ISSUE_ID, BOOK_ID, MEMBER_ID, ISSUE_DATE)
    VALUES (V_ISSUE_ID, V_BOOK_ID, V_MEMBER_ID, SYSDATE);

    COMMIT;

    DBMS_OUTPUT.PUT_LINE('BOOK ISSUED SUCCESSFULLY');
END;
/

--11. Return a Book,Member returns a book. Delete record from ISSUES using PL/SQL.
DECLARE
    V_ISSUE_ID NUMBER := 2001;
BEGIN
    DELETE FROM ISSUES
    WHERE ISSUE_ID = V_ISSUE_ID;

    COMMIT;

    DBMS_OUTPUT.PUT_LINE('BOOK RETURNED SUCCESSFULLY');
END;
/

--12)Display All Books Using Cursor,Admin wants to display all book titles.Use cursor to print titles.
BEGIN
    FOR REC IN(SELECT TITLE FROM BOOKS)LOOP
    DBMS_OUTPUT.PUT_LINE('TITLE='||REC.TITLE);
    END LOOP;
END;
/

--13). Count Issued Books,Admin wants number of issued books. Use PL/SQL block with COUNT.
DECLARE
    V_COUNT NUMBER;
BEGIN
    SELECT COUNT(*) INTO V_COUNT
    FROM ISSUES;

    DBMS_OUTPUT.PUT_LINE('TOTAL ISSUED BOOKS = ' || V_COUNT);
END;
/
--14) Handle Invalid Book ID,User enters wrong book_id. Handle exception and print "Book not found".
DECLARE
    V_BOOK_ID BOOKS.BOOK_ID%TYPE;
BEGIN
    SELECT BOOK_ID INTO V_BOOK_ID
    FROM BOOKS
    WHERE BOOK_ID = 999;  -- invalid id

    DBMS_OUTPUT.PUT_LINE('BOOK FOUND');

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('BOOK NOT FOUND');
END;
/
--15) Fine Calculation,If book is issued for more than 7 days: Print "Fine Applicable", else "No Fine".
DECLARE
    V_ISSUE_DATE ISSUES.ISSUE_DATE%TYPE;
BEGIN
    SELECT ISSUE_DATE INTO V_ISSUE_DATE
    FROM ISSUES
    WHERE ISSUE_ID = 2003;

    IF SYSDATE - V_ISSUE_DATE > 7 THEN
        DBMS_OUTPUT.PUT_LINE('FINE APPLICABLE');
    ELSE
        DBMS_OUTPUT.PUT_LINE('NO FINE');
    END IF;
END;
/
